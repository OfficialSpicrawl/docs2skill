{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "spicrawl-docs2skill-demo",
  "main": "src/worker.mjs",
  "account_id": "036bd64d65479473f0effc8c4fb126ff",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  // Only the custom domain serves this Worker. A *.workers.dev or preview URL would be a second public address for the
  // credit-spending endpoint, outside the zone's WAF and bot rules, and caches.default does nothing on it.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "docs2skill.spicrawl.com", "custom_domain": true }],
  // 2 generate calls per minute per visitor (CF-Connecting-IP; an IPv6 visitor is keyed on its /64).
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "2026102303", "simple": { "limit": 2, "period": 60 } }],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "spicrawl_demo_events" }],
  // BEACON_TOKEN: Cloudflare Web Analytics token; empty serves the page without the beacon.
  // TURNSTILE_SITE_KEY: the Turnstile widget's site key; empty (or no TURNSTILE_SECRET) turns the bot check off.
  "vars": { "BEACON_TOKEN": "dcad0906688b454486f2614da14bd8dd", "OPENPANEL_CLIENT_ID": "aefb6c53-27d1-4191-875c-f1605b9e6f26", "OPENPANEL_API_URL": "https://op.yupcha.com/api", "TURNSTILE_SITE_KEY": "" }
  // Secret, set with `wrangler secret put SPICRAWL_API_KEY` (locally: demo/.dev.vars).
  // Optional bot check: set vars.TURNSTILE_SITE_KEY and `wrangler secret put TURNSTILE_SECRET` (see README.md).
}
