{
  "name": "spicrawl-docs2skill",
  "version": "0.1.0",
  "description": "docs2skill: turn any docs site into an agent skill, llms.txt and llms-full.txt with the Spicrawl API",
  "type": "module",
  "bin": {
    "llms-txt": "./llms-txt.mjs",
    "docs2skill": "./llms-txt.mjs"
  },
  "scripts": {
    "start": "node llms-txt.mjs",
    "test": "node --test llms-txt.test.mjs demo/test/worker.test.mjs",
    "demo:dev": "cd demo && wrangler dev",
    "demo:deploy": "cd demo && wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "dependencies": {
    "@spicrawl/sdk": "^0.1.3"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
